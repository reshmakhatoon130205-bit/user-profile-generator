<!-- views/profile.ejs -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title><%= user.name %>'s Profile</title>
    <style>
        .card { max-width: 350px; margin: 50px auto; padding: 20px; border-radius: 10px; box-shadow: 0 4px 8px rgba(0,0,0,0.1); font-family: sans-serif; text-align: center; background: #fff; border-top: 5px solid #6200ee; }
        .avatar { width: 80px; height: 80px; background: #ddd; border-radius: 50%; margin: 0 auto 15px; display: flex; align-items: center; justify-content: center; font-size: 24px; font-weight: bold; color: #555; }
        .skills-container { margin: 15px 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 5px; }
        .badge { background: #f0f0f0; padding: 5px 10px; border-radius: 15px; font-size: 12px; }
        .links a { margin: 0 10px; color: #6200ee; text-decoration: none; font-weight: bold; }
    </style>
</head>
<body>

    <div class="card">
        <!-- Generates initials for avatar template -->
        <div class="avatar"><%= user.name.charAt(0).toUpperCase() %></div>
        
        <h3><%= user.name %></h3>
        <p><%= user.bio %></p>
        
        <div class="skills-container">
            <% user.skills.forEach(function(skill) { %>
                <span class="badge"><%= skill %></span>
            <% }); %>
        </div>
        
        <div class="links">
            <% if(user.github) { %><a href="<%= user.github %>" target="_blank">GitHub</a><% } %>
            <% if(user.linkedin) { %><a href="<%= user.linkedin %>" target="_blank">LinkedIn</a><% } %>
        </div>
        <br>
        <a href="/" style="font-size: 12px; color: #888;">← Create another</a>
    </div>

</body>
</html>
